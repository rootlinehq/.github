# Staging only. Leave empty until you have your own credentials.
ROOTLINE_API_KEY=
ROOTLINE_ACCOUNT_ID=
# Optional. The HMAC secret of your webhook endpoint (Developer > Webhooks).
ROOTLINE_WEBHOOK_SECRET=
# Use localhost, rather than 127.0.0.1, in your browser and allowed domains.
APP_ORIGIN=http://localhost:5173
